@page "/login"
@inject HttpClient HttpClient
@using System.Net.Http.Json

<h5 class="text-center">Login</h5>

<div class="row justify-content-center">
    <div class="col-md-6 bg-opacity-75">
        <h5 class="text-center">@ViewData["Title"]</h5>

        <EditForm Model="@loginDto" OnValidSubmit="Login">
            <DataAnnotationsValidator />
            <div class="p-3 border rounded">
                <ValidationSummary />

                <div class="mb-3">
                    <label for="login" class="form-label">Username</label>
                    <InputText id="login" class="form-control" @bind-Value="@loginDto.Login" />
                    <ValidationMessage For="@(() => loginDto.Login)" />
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label">Password</label>
                    <InputText id="password" class="form-control" @bind-Value="@loginDto.Password" type="password" />
                    <ValidationMessage For="@(() => loginDto.Password)" />
                </div>

                <button class="btn btn-success" type="submit">Login</button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    LoginDto loginDto = new LoginDto();

    private async Task Login()
    {
        var response = await HttpClient.PostAsJsonAsync("", loginDto);
        if (response.IsSuccessStatusCode)
        {
        }
        else
        {
        }
    }
}
