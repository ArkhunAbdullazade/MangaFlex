@using MangaFlex.Core.Data.Mangas.ViewModels;
@using System.Text.Json
@model MangaChapterViewModel
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

<link rel="stylesheet" href="~/css/Manga/Read/light.css" type="text/css" />
<link rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

@if (@Model.Pages is null || !@Model.Pages.Any())
{
    <p class="noData">No chapters!</p>
}
else
{
    <div class="container">
        <nav>
            <ul class="pagination justify-content-center mt-2">
                <li class="page-item @(Model.Chapter == 1 ? "disabled" : "")">
                    <a class="page-link" href="?id=@(Model.MangaId)&chapter=@(Model.Chapter-1)" tabindex="-1">&laquo; Prev
                        Chapter</a>
                </li>
                <li class="page-item disabled">
                    <div class="chapter">Vol @Model.Volume. Chapter @Model.Chapter
                        @if (!string.IsNullOrEmpty(Model.ChapterTitle))
        {
            <span class="chapterTitle">@Model.ChapterTitle</span>
        }
                    </div>
                </li>
                <li class="page-item @(Model.Chapter == Model.TotalChapters ? "disabled" : "")">
                    <a class="page-link" href="?id=@(Model.MangaId)&chapter=@(Model.Chapter+1)">Next Chapter &raquo;</a>
                </li>
            </ul>
        </nav>

        <div class="row justify-content-center">
            <div class="col-md-8">

                <div aria-label="Orange and tan hamster running in a metal wheel" role="img" class="wheel-and-hamster"
                    id="loading">
                    <div class="wheel"></div>
                    <div class="hamster">
                        <div class="hamster__body">
                            <div class="hamster__head">
                                <div class="hamster__ear"></div>
                                <div class="hamster__eye"></div>
                                <div class="hamster__nose"></div>
                            </div>
                            <div class="hamster__limb hamster__limb--fr"></div>
                            <div class="hamster__limb hamster__limb--fl"></div>
                            <div class="hamster__limb hamster__limb--br"></div>
                            <div class="hamster__limb hamster__limb--bl"></div>
                            <div class="hamster__tail"></div>
                        </div>
                    </div>
                    <div class="spoke"></div>
                </div>

                <div class="col-md-4 align-items-center justify-content-center">
                    <img class="manga-page" id="mangaPage" src="@Model.Pages.FirstOrDefault()" alt="Manga Page">
                    <span class="material-symbols-rounded prev-arrow" id="prevPageBtn">arrow_back_ios</span>
                    <span class="material-symbols-rounded next-arrow" id="nextPageBtn">arrow_forward_ios</span>
                </div>
            </div>
        </div>

        <nav>
            <ul class="pagination justify-content-center mt-2">
                <li class="page-item @(Model.Chapter == 1 ? "disabled" : "")">
                    <a class="page-link" href="?id=@(Model.MangaId)&chapter=@(Model.Chapter-1)" tabindex="-1">&laquo; Prev
                        Chapter</a>
                </li>
                <li class="page-item disabled">
                    <div class="chapter">Vol @Model.Volume. Chapter @Model.Chapter
                        @if (!string.IsNullOrEmpty(Model.ChapterTitle))
        {
            <span class="chapterTitle">@Model.ChapterTitle</span>
        }
                    </div>
                </li>
                <li class="page-item @(Model.Chapter == Model.TotalChapters ? "disabled" : "")">
                    <a class="page-link" href="?id=@(Model.MangaId)&chapter=@(Model.Chapter+1)">Next Chapter &raquo;</a>
                </li>
            </ul>
        </nav>
    </div>
}
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var currentPageIndex = 0;
        var jsPageUrls = @Html.Raw(JsonSerializer.Serialize(Model.Pages));
        var mangaPage = document.getElementById("mangaPage");
        var prevArrow = document.getElementById("prevPageBtn");
        var nextArrow = document.getElementById("nextPageBtn");

        showPage(currentPageIndex);

        function showPage(pageIndex) {
            var pageUrl = jsPageUrls[pageIndex];
            if (pageUrl) {
                mangaPage.src = pageUrl;
            }

            prevArrow.style.visibility = pageIndex === 0 ? "hidden" : "visible";
        }

        prevArrow.addEventListener("click", function () {
            if (currentPageIndex > 0) {
                currentPageIndex--;
                showPage(currentPageIndex);
            } else {
                var prevChapter = @(Model.Chapter - 1);
                if (prevChapter >= 1) {
                    window.location.href = "?id=@(Model.MangaId)&chapter=" + prevChapter;
                }
            }
            prevArrow.classList.add("clicked");
            setTimeout(function () {
                prevArrow.classList.remove("clicked");
            }, 300);
        });

        nextArrow.addEventListener("click", function () {
            if (currentPageIndex < jsPageUrls.length - 1) {
                currentPageIndex++;
                showPage(currentPageIndex);
            } else {
                var nextChapter = @(Model.Chapter + 1);
                if (nextChapter <= @(Model.TotalChapters)) {
                    window.location.href = "?id=@(Model.MangaId)&chapter=" + nextChapter;
                }
            }
            nextArrow.classList.add("clicked"); // Добавляем класс для анимации
            setTimeout(function () {
                nextArrow.classList.remove("clicked"); // Удаляем класс после завершения анимации
            }, 300);
        });

        document.addEventListener("keydown", function (event) {
            if (event.key === "ArrowLeft") {
                if (currentPageIndex > 0) {
                    currentPageIndex--;
                    showPage(currentPageIndex);
                } else {
                    var prevChapter = @(Model.Chapter - 1);
                    if (prevChapter >= 1) {
                        window.location.href = "?id=@(Model.MangaId)&chapter=" + prevChapter;
                    }
                }
            } else if (event.key === "ArrowRight") {
                if (currentPageIndex < jsPageUrls.length - 1) {
                    currentPageIndex++;
                    showPage(currentPageIndex);
                } else {
                    var nextChapter = @(Model.Chapter + 1);
                    if (nextChapter <= @(Model.TotalChapters)) {
                        window.location.href = "?id=@(Model.MangaId)&chapter=" + nextChapter;
                    }
                }
            }
        });
    });

    $(window).on('load', function () {
        $('#loading').hide();
    }) 
</script>