@using MangaFlex.Core.Data.Mangas.ViewModels;
@using System.Text.Json
@model MangaChapterViewModel

<style>
    img {
        width: 750px;
        display: block;
        margin: 0 auto;
    }

    .noData {
        color: red;
        text-align: center;
        font-size: 30px;
        font-weight: bold;
    }

    .prev-arrow {
        left: 30vh;
        opacity: 0.8;
    }

    .next-arrow {
        right: 40vh;
        opacity: 0.8;
    }

    .material-symbols-rounded {
        font-variation-settings:
            'FILL' 0,
            'wght' 200,
            'GRAD' 0,
            'opsz' NaN;
        font-size: 20vh !important;
        position: absolute;
        top: 50%;
        cursor: pointer;
        transform: translateY(-50%);
        text-align: center;
        transition: color 0.3s, background-color 0.3s, opacity 0.3s, transform 0.3s;
    }

    .material-symbols-rounded:hover {
        color: rgb(0, 0, 0);
        transform: translateY(-50%) scale(1.1);
    }
</style>
<link rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

@if (@Model.Pages is null || !@Model.Pages.Any())
{
    <p class="noData">No chapters!</p>
}
else
{
    <div class="container">
        <nav>
            <ul class="pagination justify-content-center mt-2">
                <li class="page-item @(Model.Chapter == 1 ? "disabled" : "")">
                    <a class="page-link" href="?id=@(Model.MangaId)&chapter=@(Model.Chapter-1)" tabindex="-1">&laquo; Prev
                        Chapter</a>
                </li>
                <li class="page-item disabled">
                    <span class="page-link">Chapter @Model.Chapter</span>
                </li>
                <li class="page-item @(Model.Chapter == Model.TotalChapters ? "disabled" : "")">
                    <a class="page-link" href="?id=@(Model.MangaId)&chapter=@(Model.Chapter+1)">Next Chapter &raquo;</a>
                </li>
            </ul>
        </nav>

        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="col-md-4 align-items-center justify-content-center">
                    <img id="mangaPage" src="@Model.Pages.FirstOrDefault()" alt="Manga Page">
                    <span class="material-symbols-rounded prev-arrow" id="prevPageBtn">arrow_back_ios</span>
                    <span class="material-symbols-rounded next-arrow" id="nextPageBtn">arrow_forward_ios</span>
                </div>
            </div>
        </div>

        <nav>
            <ul class="pagination justify-content-center mt-2">
                <li class="page-item @(Model.Chapter == 1 ? "disabled" : "")">
                    <a class="page-link" href="?id=@(Model.MangaId)&chapter=@(Model.Chapter-1)" tabindex="-1">&laquo; Prev
                        Chapter</a>
                </li>
                <li class="page-item disabled">
                    <span class="page-link">Chapter @Model.Chapter</span>
                </li>
                <li class="page-item @(Model.Chapter == Model.TotalChapters ? "disabled" : "")">
                    <a class="page-link" href="?id=@(Model.MangaId)&chapter=@(Model.Chapter+1)">Next Chapter &raquo;</a>
                </li>
            </ul>
        </nav>
    </div>
}
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var currentPageIndex = 0;
        var jsPageUrls = @Html.Raw(JsonSerializer.Serialize(Model.Pages));
        var mangaPage = document.getElementById("mangaPage");
        var prevArrow = document.getElementById("prevPageBtn");
        var nextArrow = document.getElementById("nextPageBtn");

        showPage(currentPageIndex);

        function showPage(pageIndex) {
            var pageUrl = jsPageUrls[pageIndex];
            if (pageUrl) {
                mangaPage.src = pageUrl;
            }

            prevArrow.style.visibility = pageIndex === 0 ? "hidden" : "visible";
        }

        prevArrow.addEventListener("click", function () {
            if (currentPageIndex > 0) {
                currentPageIndex--;
                showPage(currentPageIndex);
            } else {
                var prevChapter = @(Model.Chapter - 1);
                if (prevChapter >= 1) {
                    window.location.href = "?id=@(Model.MangaId)&chapter=" + prevChapter;
                }
            }
        });

        nextArrow.addEventListener("click", function () {
            if (currentPageIndex < jsPageUrls.length - 1) {
                currentPageIndex++;
                showPage(currentPageIndex);
            } else {
                var nextChapter = @(Model.Chapter + 1);
                if (nextChapter <= @(Model.TotalChapters)) {
                    window.location.href = "?id=@(Model.MangaId)&chapter=" + nextChapter;
                }
            }
        });

        document.addEventListener("keydown", function (event) {
            if (event.key === "ArrowLeft") {
                if (currentPageIndex > 0) {
                    currentPageIndex--;
                    showPage(currentPageIndex);
                } else {
                    var prevChapter = @(Model.Chapter - 1);
                    if (prevChapter >= 1) {
                        window.location.href = "?id=@(Model.MangaId)&chapter=" + prevChapter;
                    }
                }
            } else if (event.key === "ArrowRight") {
                if (currentPageIndex < jsPageUrls.length - 1) {
                    currentPageIndex++;
                    showPage(currentPageIndex);
                } else {
                    var nextChapter = @(Model.Chapter + 1);
                    if (nextChapter <= @(Model.TotalChapters)) {
                        window.location.href = "?id=@(Model.MangaId)&chapter=" + nextChapter;
                    }
                }
            }
        });
    });
</script>